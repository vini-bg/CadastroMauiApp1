<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroMauiApp1.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="calendario.png"
                HeightRequest="180"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />
            <Border Padding="10" Margin="10">
                
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="*, *"
                          RowSpacing="12">
                        
                        <Label
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            HorizontalTextAlignment="Center"
                            Text="Nome do Evento"
                            TextColor="Black"
                            FontSize="25"
                            Style="{StaticResource Headline}"
                            SemanticProperties.HeadingLevel="Level1" />
                        <Entry
                            Grid.Row="1" Grid.ColumnSpan="2"
                            PlaceholderColor="Gray" 
                            TextColor="Black"
                            Placeholder="Digite o nome do evento"
                            Text="{Binding Nome}"/>

                        <Label
                             Grid.Column="0"
                             Grid.Row="2"
                             FontSize="18"
                             LineBreakMode="NoWrap"
                             HorizontalTextAlignment="Center"
                             Text="Data de início" />

                        <DatePicker 
                            Grid.Column="0"
                            Grid.Row="4"
                            HorizontalOptions="Center"
                            x:Name="dt_inicio"
                            Format="dd/MM/yyyy"
                            Date="{Binding DataInicio}"/>

                        <Label 
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="Data de término"
                                FontSize="18"
                                HorizontalTextAlignment="Center"/>

                        <DatePicker 
                                Grid.Column="1"
                                Grid.Row="4"
                                HorizontalOptions="Center"
                                x:Name="dt_termino"
                                Format="dd/MM/yyyy"
                                Date="{Binding DataTermino}"/>
                        <Label 
                            HorizontalTextAlignment="Center"
                            Grid.ColumnSpan="2"
                            Grid.Row="5"
                            Text="Número de Participantes"/>

                        <Label Grid.Row="6" Grid.Column="1"
                               Text="{Binding Participantes}"
                               TextColor="Black"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0, 0, 100, 0"/>

                        <Stepper 
                                x:Name="stp_participantes"
                                Grid.Column="0"
                                HorizontalOptions="Center"
                                Grid.Row="6"
                                Maximum="100"
                                Minimum="1"
                                Increment="1"
                                Margin="80, 0, 0, 0"
                                Value="{Binding Participantes}"/>

                        <Label 
                            Text="Local do Evento"
                            Grid.Row="7"
                            Grid.ColumnSpan="2"
                            HorizontalTextAlignment="Center"/>

                        <Entry 
                            Grid.Row="8"
                            Grid.ColumnSpan="2"
                            Placeholder="Digite o local do evento"
                            TextColor="Black"
                            Text="{Binding Local}"
                            PlaceholderColor="Gray"/>

                        <Label 
                            Text="Custo por participante"
                            Grid.Row="9"
                            Grid.ColumnSpan="2"
                            HorizontalTextAlignment="Center"/>

                        <Entry 
                            Grid.Row="10"
                            Grid.ColumnSpan="2"
                            Placeholder="R$"
                            Keyboard="Numeric"
                            Text="{Binding Custo}"
                            PlaceholderColor="Gray"/>
                </Grid>
               
            </Border>

            <Button
                x:Name="btn_cadastrar"
                Text="Cadastrar" 
                BackgroundColor="#38952C"
                Clicked="btn_cadastrar_Clicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
